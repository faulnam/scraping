[Unit]
Description=LeadMaps BI - FastAPI Application
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/leadmaps-bi
Environment="PATH=/var/www/leadmaps-bi/venv/bin"
EnvironmentFile=/var/www/leadmaps-bi/.env
ExecStart=/var/www/leadmaps-bi/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
