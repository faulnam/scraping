# ==========================================
# 1. KONFIGURASI DATABASE MYSQL
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leadmaps_bi

# (Opsional) Jika ingin menggunakan connection string langsung:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/leadmaps_bi

# ==========================================
# 2. GOOGLE PLACES API (NEW) KEY
# ==========================================
# Masukkan API Key asli dari Google Cloud Console untuk menarik data ASLI (Live Real Data).
# Jika baris ini dikosongkan (GOOGLE_MAPS_API_KEY=), sistem otomatis masuk ke Mock Mode (data dummy JSON).
GOOGLE_MAPS_API_KEY=

# ==========================================
# 3. PENGATURAN APLIKASI
# ==========================================
DEBUG=True
APP_NAME=LeadMaps BI
APP_ENV=development
SECRET_KEY=change_this_secret_key_in_production
